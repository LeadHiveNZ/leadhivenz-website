# =============================================================================
# HostFix settings
# -----------------------------------------------------------------------------
# These are the keys and passwords the site needs. NEVER put real values in
# this file. Real values go in your hosting settings:
#   Vercel > your project > Settings > Environment Variables
# After changing any of them on Vercel you must redeploy for it to take effect.
#
# SETUP.md explains where each value comes from, in the order to do them.
# To run the site on your own computer, copy this file to ".env.local" and
# fill in what you have. Anything left blank simply stays switched off.
# =============================================================================

# --- Sign-in --------------------------------------------------------------------
# The admin password. A long password only you know, at least 10 characters.
# It always works at /admin, even before any staff have been added.
ADMIN_PASSWORD=
# A random string of at least 32 characters. It signs cookies and the one-tap
# links in texts. Any long random text works. Changing it signs everyone out
# and stops links in old texts from opening.
APP_SECRET=

# --- Database (Supabase) --------------------------------------------------------
# The "Transaction pooler" connection string from Supabase > Connect. It looks
# like: postgresql://postgres.abcdefgh:YOUR-PASSWORD@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres
# Put your real database password in place of [YOUR-PASSWORD].
DATABASE_URL=
# Optional. Supabase's certificate, to check the database's identity as well as
# encrypting the connection (Supabase > Database > Settings > SSL Configuration).
DATABASE_CA_CERT=
# Optional. How many database connections each copy of the site may hold. Default 3.
DATABASE_POOL_MAX=

# --- Photos (Supabase Storage) --------------------------------------------------
# Project URL, for example https://abcdefgh.supabase.co
SUPABASE_URL=
# The SECRET key (starts with sb_secret_). Not the publishable key.
SUPABASE_SECRET_KEY=
# Optional. The name of the private bucket photos are kept in. Default: hostfix.
# It is made automatically the first time a photo is saved.
SUPABASE_BUCKET=

# --- The timer -------------------------------------------------------------------
# A random string of at least 16 characters. Vercel sends it with each
# once-a-minute call to the timer, so nobody else can set the timer off.
CRON_SECRET=

# --- Alerts to you ---------------------------------------------------------------
# Where alert emails go: new leads, and anything that lands in the queue.
# Several addresses can be separated with commas.
ALERT_EMAIL_TO=
# Where alert texts go: new leads, and the urgent queue items (nobody accepted,
# a missed promise, a problem raised, a bank reversing a payment). Must start
# with + and the country code, for example +61412345678 or +64211234567.
ALERT_SMS_TO=

# --- Email (Resend) --------------------------------------------------------------
# Sends sign-in codes to owners and staff, and alerts to you.
RESEND_API_KEY=
# Needed before real owners can sign in. Until your own domain is verified in
# Resend, emails only reach the address that owns your Resend account. Once it
# is verified, set this to something like:  HostFix <hello@yourdomain.co.nz>
EMAIL_FROM=

# --- Texts ------------------------------------------------------------------------
# Texts are sent through ClickSend (the default) ...
CLICKSEND_USERNAME=
CLICKSEND_API_KEY=
# Optional sender name or number. Leave blank to use ClickSend's shared number.
SMS_FROM=
# ... or through Twilio. To use Twilio, set SMS_PROVIDER=twilio and fill these in.
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# A Twilio phone number (+1...) or a Messaging Service ID (MG...).
TWILIO_FROM=
# Optional. Only if tradies can reply YES to a ClickSend number. A random string
# of at least 16 characters that goes on the end of the address you give ClickSend.
SMS_INBOUND_SECRET=

# --- Card payments and tradie payouts (Stripe) -----------------------------------
# One Stripe account per country. New Zealand markets use the NZ pair.
# Start with your test key (sk_test_...) and swap to live (sk_live_...) later.
STRIPE_NZ_SECRET_KEY=
# The signing secret of the webhook you create in Stripe (starts with whsec_).
STRIPE_NZ_WEBHOOK_SECRET=
# Australia, when you launch there. It needs its own Stripe account.
STRIPE_AU_SECRET_KEY=
STRIPE_AU_WEBHOOK_SECRET=

# --- Meta (Facebook and Instagram) tracking --------------------------------------
# Your Pixel ID: digits only. This one is read when the site is built, so a
# redeploy is needed after changing it.
NEXT_PUBLIC_META_PIXEL_ID=
# Conversions API access token, from Events Manager.
META_CAPI_ACCESS_TOKEN=
# Optional. Only while testing in Events Manager > Test Events. Remove afterwards.
META_TEST_EVENT_CODE=
# Optional. Leave blank unless Meta retires the default version.
META_GRAPH_VERSION=

# --- Usually left blank ----------------------------------------------------------
# The public address of the site. Vercel works this out by itself. Set it only
# when running somewhere else, for example http://localhost:3000
APP_URL=
# Set to 1 to try the whole product on your own computer with no accounts at
# all. It starts with a made-up sample business, keeps everything in the .data
# folder, sends no real texts and moves no real money. Ignored on Vercel.
HOSTFIX_DEMO=
# Demo mode only. Set to 0 to start the demo empty instead of with the sample business.
HOSTFIX_SAMPLE_DATA=
