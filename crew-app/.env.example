# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Used by `npm run seed` and never shipped to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App ---
# Public URL of the deployed app (used for magic-link redirects).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Google Calendar (phase 3, live sync) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=primary

# --- Xero (phase 2, draft export) ---
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
